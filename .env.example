APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
STAFF_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Temporary SQL timings for /admin, /admin/residents, /admin/staff, /admin/sectors.
# Defaults to enabled in local environments. Disable after profiling.
DB_QUERY_LOG_ENABLED=true
DB_QUERY_LOG_MIN_MS=0

# Avoid a remote database lookup on each authenticated request.
AUTH_USER_CACHE_STORE=file
AUTH_USER_CACHE_TTL=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail API over HTTPS: set MAIL_MAILER=gmail to enable.
# MAIL_FROM_ADDRESS must be the authorized sender Gmail or an approved alias.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_CA_BUNDLE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Lupon: approved local DOCX templates (blank uses unsigned system layouts).
LUPON_NOTICE_TEMPLATE=
LUPON_SUMMONS_TEMPLATE=
LUPON_SETTLEMENT_TEMPLATE=
LUPON_CFA_TEMPLATE=
# Comma-separated local/non-working holiday dates, YYYY-MM-DD.
LUPON_HOLIDAYS=

# Server-side AI assistant key (never use a VITE_ prefix)
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
# Optional trusted CA bundle for PHP installations without a configured certificate store
GROQ_CA_BUNDLE=

RESIDENT_REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
